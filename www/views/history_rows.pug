include details.pug
include history.pug
include image.pug

- const rowType = entity_type || 'character';
each val in characters
    - let suffix = '';
    -
        if(rowType === 'character' && val.corporation_id === 1000001)
        {
            suffix = ' (recycled)';
        }
        else if(rowType === 'corporation' && val.memberCount == 0)
        {
            suffix = ' (closed)';
        }
    tr
        td.image
            +image(rowType, val.id, 64, val.name)
        td.namee
            a(href='/' + rowType + '/' + val.id)= val.name + suffix
        td
          span.dates.align-right.departed= val.end_date
          br
          span.dates.align-right.joined= val.start_date
